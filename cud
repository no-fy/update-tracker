#!/usr/bin/env python3
"""cud -- container update dashboard.

    cud serve                 start the web dashboard
    cud check                 print an update report to the terminal
    cud hosts                 list configured hosts
    cud add --local           register this machine's Docker socket
    cud remove nas            forget a host (does not stop its agent)

Remote hosts are added from the dashboard: it gives you a command to run on
the machine, and the agent there enrols itself.
"""

import argparse
import os
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)

from dashboard import collector, config as config_mod  # noqa: E402
from dashboard import server as server_mod  # noqa: E402

RESET = "\033[0m"
BOLD = "\033[1m"
DIM = "\033[2m"
COLOURS = {
    "update-available": "\033[33m",
    "restart-pending": "\033[33m",
    "error": "\033[31m",
    "unknown": "\033[90m",
    "pinned": "\033[36m",
    "ignored": "\033[90m",
    "up-to-date": "\033[32m",
}
GLYPHS = {
    "update-available": "^",
    "restart-pending": "~",
    "error": "!",
    "unknown": "?",
    "pinned": "=",
    "ignored": "-",
    "up-to-date": ".",
}


def _tty():
    return sys.stdout.isatty()


def paint(text, colour):
    if not _tty():
        return text
    return "%s%s%s" % (colour, text, RESET)


def cmd_serve(args):
    return server_mod.run(args.config, args.bind, args.port, args.verbose)


def cmd_check(args):
    config, config_path = config_mod.load_config(args.config)
    hosts = config.get("hosts", [])
    if not hosts:
        print("No hosts configured. Register this machine with:  ./cud add --local")
        print("For other machines, start the dashboard and use Add host:  ./cud serve")
        return 1

    settings = config.get("dashboard", {})
    started = time.time()
    results = collector.poll_hosts(
        hosts,
        timeout=settings.get("poll_timeout_seconds", 20),
        max_workers=settings.get("max_parallel_hosts", 8),
        include_stopped=settings.get("include_stopped", True),
    )
    client = server_mod.make_registry_client(
        config, cache_path=config_mod.default_cache_path(config_path)
    )
    collector.enrich_with_registry(
        results, client, max_workers=settings.get("max_parallel_registry_lookups", 6)
    )
    summary = collector.summarise(results)

    for host in results:
        header = "%s (%s)" % (host["label"], host["name"])
        if not host["online"]:
            print("\n%s  %s" % (paint(header, BOLD), paint("offline: " + (host["error"] or "?"), COLOURS["error"])))
            continue
        info_bits = [
            b for b in (
                host["info"].get("docker_version") and "docker " + host["info"]["docker_version"],
                host["info"].get("os"),
            ) if b
        ]
        print("\n%s  %s" % (paint(header, BOLD), paint(" | ".join(info_bits), DIM)))

        rows = host["containers"]
        if args.updates_only:
            rows = [c for c in rows if c["update_status"] in collector.NEEDS_ATTENTION]
        if not rows:
            print("  %s" % paint("nothing to report", DIM))
            continue

        width = max(len(c["name"]) for c in rows)
        for container in sorted(rows, key=lambda c: (
            collector.STATUS_ORDER.index(c["update_status"])
            if c["update_status"] in collector.STATUS_ORDER else 99, c["name"])
        ):
            status = container["update_status"]
            colour = COLOURS.get(status, "")
            line = "  %s %-*s  %s" % (
                paint(GLYPHS.get(status, "?"), colour),
                width,
                container["name"],
                container["image_display"],
            )
            print(line)
            if status in collector.NEEDS_ATTENTION or status == "error":
                print("      %s" % paint(container["detail"], colour))

    counts = summary["counts"]
    print("\n" + paint("Summary", BOLD))
    print("  %d containers on %d/%d hosts online" % (
        summary["containers_total"], summary["hosts_online"], summary["hosts_total"]))
    for status in collector.STATUS_ORDER:
        if counts.get(status):
            print("  %s %-17s %d" % (
                paint(GLYPHS.get(status, "?"), COLOURS.get(status, "")), status, counts[status]))
    print("  checked in %.1fs  (config: %s)" % (time.time() - started, config_path))

    return 1 if summary["needs_attention"] and args.exit_code else 0


def cmd_hosts(args):
    config, config_path = config_mod.load_config(args.config)
    hosts = config.get("hosts", [])
    if not hosts:
        print("No hosts configured (%s)" % config_path)
        return 0
    width = max(len(h.get("name", "")) for h in hosts)
    for host in hosts:
        target = "local socket %s" % host.get("docker_socket") if host.get("mode") == "local" \
            else "%s:%s" % (host.get("address"), host.get("port"))
        flags = [] if host.get("enabled", True) else ["disabled"]
        print("  %-*s  %-32s %s" % (width, host.get("name"), target, " ".join(flags)))
    print("\n  %s" % paint(config_path, DIM))
    return 0


def cmd_add(args):
    """Register this machine's Docker socket.

    Remote hosts are not added from here any more: they run the agent
    container and enrol themselves. `cud serve` prints the dashboard address;
    use Add host there.
    """
    if not args.local:
        if getattr(args, "target", None):
            print("'%s' cannot be added from here any more." % args.target)
        print("Remote hosts enrol themselves now -- there is nothing to install over SSH.")
        print("Start the dashboard and use Add host, which gives you a command to")
        print("paste on the machine you want to watch:")
        print()
        print("  ./cud serve")
        print()
        print("To register this machine instead:  ./cud add --local")
        return 2

    config, config_path = config_mod.load_config(args.config)
    socket_path = args.docker_socket or os.environ.get("DOCKER_HOST") or "/var/run/docker.sock"
    if socket_path.startswith("unix://"):
        socket_path = socket_path[len("unix://"):]

    sys.path.insert(0, os.path.join(HERE, "agent"))
    import agent as agent_module

    try:
        snapshot = agent_module.collect_snapshot(agent_module.DockerClient(socket_path))
    except Exception as exc:
        print(paint("fail", COLOURS["error"]) + " %s" % exc)
        print("The dashboard needs read access to the socket -- be in the `docker` group.")
        return 1

    count = len(snapshot.get("containers") or [])
    host = {
        "name": args.name or "local",
        "mode": "local",
        "label": args.label or "This machine",
        "docker_socket": socket_path,
        "enabled": True,
    }
    _, created = config_mod.upsert_host(config, host)
    config_mod.save_config(config, config_path)
    print(paint("ok", COLOURS["up-to-date"]) + "   read %d containers from %s"
          % (count, socket_path))
    print(paint("ok", COLOURS["up-to-date"]) + "   %s host '%s' in %s"
          % ("added" if created else "updated", host["name"], config_path))
    return 0


def cmd_remove(args):
    config, config_path = config_mod.load_config(args.config)
    removed = config_mod.remove_host(config, args.name)
    if not removed:
        print("No host named '%s'" % args.name)
        return 1
    config_mod.save_config(config, config_path)
    print("Removed '%s' from %s" % (args.name, config_path))
    if removed.get("mode") == "agent":
        print("The agent is still running on it. To stop it too, on that machine:")
        print("  docker rm -f container-update-agent")
    return 0


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)

    parser = argparse.ArgumentParser(
        prog="cud",
        description="Container update dashboard",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    parser.add_argument("--config", help="path to config.json")
    sub = parser.add_subparsers(dest="command")

    p_serve = sub.add_parser("serve", help="start the web dashboard")
    p_serve.add_argument("--bind")
    p_serve.add_argument("--port", type=int)
    p_serve.add_argument("--verbose", action="store_true")
    p_serve.set_defaults(func=cmd_serve)

    p_check = sub.add_parser("check", help="print an update report")
    p_check.add_argument("--updates-only", action="store_true", help="hide up-to-date containers")
    p_check.add_argument("--exit-code", action="store_true",
                         help="exit 1 when something needs an update (for cron)")
    p_check.set_defaults(func=cmd_check)

    p_hosts = sub.add_parser("hosts", help="list configured hosts")
    p_hosts.set_defaults(func=cmd_hosts)

    p_add = sub.add_parser("add", help="register this machine's Docker socket")
    p_add.add_argument("target", nargs="?", help=argparse.SUPPRESS)
    p_add.add_argument("--local", action="store_true", help="register this machine")
    p_add.add_argument("--name", help="short name (default: local)")
    p_add.add_argument("--label", help="display name in the dashboard")
    p_add.add_argument("--docker-socket", help="socket path (default /var/run/docker.sock)")
    p_add.set_defaults(func=cmd_add)

    p_remove = sub.add_parser("remove", help="forget a host")
    p_remove.add_argument("name")
    p_remove.set_defaults(func=cmd_remove)

    args = parser.parse_args(argv)
    if not args.command:
        parser.print_help()
        return 0
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
